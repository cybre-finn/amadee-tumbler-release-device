#include "pico/stdlib.h"

// Deine Pin-Zuweisung
#define STEP_PIN 2  // GPIO2 (Pico Pin 4)
#define DIR_PIN 4   // GPIO4 (Pico Pin 6)

// Pausenzeiten definieren die Geschwindigkeit (in Mikrosekunden).
// 1000us = 1ms. Je kleiner der Wert, desto schneller dreht der Motor.
#define DELAY_US 1000 

int main() {
    // 1. Initialisierung der Pins
    gpio_init(STEP_PIN);
    gpio_init(DIR_PIN);

    // 2. Pins als Ausgänge (Outputs) konfigurieren
    gpio_set_dir(STEP_PIN, GPIO_OUT);
    gpio_set_dir(DIR_PIN, GPIO_OUT);

    // 3. Drehrichtung festlegen (1 = Vorwärts, 0 = Rückwärts)
    gpio_put(DIR_PIN, 1);

    // 4. Endlosschleife für die Schritte
    while (true) {
        // Step High (Impuls Start)
        gpio_put(STEP_PIN, 1);
        sleep_us(DELAY_US); // Kurz warten

        // Step Low (Impuls Ende)
        gpio_put(STEP_PIN, 0);
        sleep_us(DELAY_US); // Warten bis zum nächsten Schritt
    }
}
