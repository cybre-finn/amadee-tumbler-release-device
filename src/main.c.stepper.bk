#include "pico/stdlib.h"

// --- PIN ZUWEISUNGEN ---
#define STEP_PIN 2  // GPIO 2
#define DIR_PIN 4   // GPIO 4
#define BUTTON_PIN 15 // Unser neuer Taster-Pin (verbindet GPIO 15 mit GND)

// --- MOTOR SETUP ---
#define DELAY_US 1000
#define STEPS_PER_REV 3200 

// --- ZEIT-KONSTANTEN (in Millisekunden) ---
#define DOUBLE_CLICK_TIME 250 // Max Zeit zwischen zwei Klicks
#define LONG_PRESS_TIME 400   // Ab wann ein "Halten" erkannt wird

// Hilfsfunktion: Ein einzelner Schritt
void do_step() {
    gpio_put(STEP_PIN, 1);
    sleep_us(DELAY_US);
    gpio_put(STEP_PIN, 0);
    sleep_us(DELAY_US);
}

// Hilfsfunktion: Eine volle Umdrehung
void do_rotation(int dir) {
    gpio_put(DIR_PIN, dir);
    for (int i = 0; i < STEPS_PER_REV; i++) {
        do_step();
    }
}

int main() {
    // 1. Motor Pins initialisieren
    gpio_init(STEP_PIN);
    gpio_init(DIR_PIN);
    gpio_set_dir(STEP_PIN, GPIO_OUT);
    gpio_set_dir(DIR_PIN, GPIO_OUT);

    // 2. Button Pin initialisieren (mit Pull-Up)
    gpio_init(BUTTON_PIN);
    gpio_set_dir(BUTTON_PIN, GPIO_IN);
    gpio_pull_up(BUTTON_PIN); // Interner Widerstand zieht den Pin auf HIGH

    // 3. Status-Variablen für die Knopferkennung
    uint32_t press_time = 0;
    uint32_t release_time = 0;
    int click_count = 0;
    bool is_pressed = false;
    bool long_press_active = false;

    // 4. Hauptschleife
    while (true) {
        // Button auslesen (LOW bedeutet gedrückt, weil Pull-Up aktiv)
        bool current_state = !gpio_get(BUTTON_PIN);
        uint32_t now = to_ms_since_boot(get_absolute_time());

        // Flankenerkennung: Knopf wurde GERADE EBEN heruntergedrückt
        if (current_state && !is_pressed) {
            is_pressed = true;
            press_time = now;
        } 
        // Flankenerkennung: Knopf wurde GERADE EBEN losgelassen
        else if (!current_state && is_pressed) {
            is_pressed = false;
            uint32_t duration = now - press_time;

            // Debouncing (>20ms) und prüfen ob es kein langes Halten war
            if (duration > 20 && !long_press_active) {
                click_count++;
                release_time = now;
            }
            long_press_active = false; // Reset nach dem Loslassen
        }

        // --- AKTION 3: LANGE DRÜCKEN (Kontinuierlich) ---
        // Wenn der Knopf aktuell gedrückt ist und die Zeit abgelaufen ist
        if (is_pressed && (now - press_time > LONG_PRESS_TIME)) {
            long_press_active = true;
            click_count = 0; // Etwaige einfache Klicks stornieren
            
            gpio_put(DIR_PIN, 1); // Vorwärts
            do_step();            // Solange die Schleife läuft, dreht er endlos weiter
        }

        // --- AKTION 2: DOPPELKLICK ---
        // Wurde der Knopf zweimal gedrückt?
        if (click_count == 2) {
            click_count = 0; // Counter zurücksetzen
            
            do_rotation(0); // Rückwärts drehen
        }

        // --- AKTION 1: EINZELKLICK ---
        // Wir haben 1 Klick, der Knopf ist losgelassen, UND die Wartezeit 
        // für einen möglichen zweiten Klick ist verstrichen
        if (click_count == 1 && !is_pressed && (now - release_time > DOUBLE_CLICK_TIME)) {
            click_count = 0; // Counter zurücksetzen
            
            do_rotation(1); // Vorwärts drehen
        }

        // Winzige Pause entlastet die CPU
        sleep_ms(1); 
    }
}
