#include <stdio.h>
#include "pico/stdlib.h"

// Software (bit-banged) I2C, because GPIO21/22 are not a valid hardware I2C pair
static uint sda_pin = 21;
static uint scl_pin = 22;
#define I2C_DELAY_US 10

#define VL53_ADDR 0x29

// Graph scaling: one '#' per GRAPH_MM_PER_CHAR millimeters
#define GRAPH_MM_PER_CHAR 20
#define GRAPH_MAX_CHARS 60

static inline void sda_high(void) { gpio_set_dir(sda_pin, GPIO_IN); }
static inline void sda_low(void)  { gpio_set_dir(sda_pin, GPIO_OUT); }
static inline void scl_high(void) { gpio_set_dir(scl_pin, GPIO_IN); }
static inline void scl_low(void)  { gpio_set_dir(scl_pin, GPIO_OUT); }

static void i2c_init_pins(void) {
    gpio_deinit(sda_pin);
    gpio_deinit(scl_pin);
    gpio_init(sda_pin);
    gpio_init(scl_pin);
    gpio_put(sda_pin, 0);
    gpio_put(scl_pin, 0);
    gpio_pull_up(sda_pin);
    gpio_pull_up(scl_pin);
    sda_high();
    scl_high();
}

static void i2c_start(void) {
    sda_high();
    scl_high();
    sleep_us(I2C_DELAY_US);
    sda_low();
    sleep_us(I2C_DELAY_US);
    scl_low();
}

static void i2c_stop(void) {
    sda_low();
    sleep_us(I2C_DELAY_US);
    scl_high();
    sleep_us(I2C_DELAY_US);
    sda_high();
    sleep_us(I2C_DELAY_US);
}

// Returns true if the slave acknowledged
static bool i2c_write_byte(uint8_t b) {
    for (int i = 7; i >= 0; i--) {
        if ((b >> i) & 1) sda_high(); else sda_low();
        sleep_us(I2C_DELAY_US);
        scl_high();
        sleep_us(I2C_DELAY_US);
        scl_low();
    }
    sda_high();
    sleep_us(I2C_DELAY_US);
    scl_high();
    sleep_us(I2C_DELAY_US);
    bool ack = !gpio_get(sda_pin);
    scl_low();
    return ack;
}

static uint8_t i2c_read_byte(bool ack) {
    uint8_t b = 0;
    sda_high();
    for (int i = 0; i < 8; i++) {
        sleep_us(I2C_DELAY_US);
        scl_high();
        sleep_us(I2C_DELAY_US);
        b = (b << 1) | gpio_get(sda_pin);
        scl_low();
    }
    if (ack) sda_low(); else sda_high();
    sleep_us(I2C_DELAY_US);
    scl_high();
    sleep_us(I2C_DELAY_US);
    scl_low();
    sda_high();
    return b;
}

static bool reg_write(uint8_t reg, uint8_t val) {
    i2c_start();
    bool ok = i2c_write_byte(VL53_ADDR << 1) && i2c_write_byte(reg) && i2c_write_byte(val);
    i2c_stop();
    return ok;
}

static bool reg_read(uint8_t reg, uint8_t *buf, int len) {
    i2c_start();
    if (!i2c_write_byte(VL53_ADDR << 1) || !i2c_write_byte(reg)) {
        i2c_stop();
        return false;
    }
    i2c_start();
    if (!i2c_write_byte((VL53_ADDR << 1) | 1)) {
        i2c_stop();
        return false;
    }
    for (int i = 0; i < len; i++) buf[i] = i2c_read_byte(i < len - 1);
    i2c_stop();
    return true;
}

static uint8_t reg_read8(uint8_t reg) {
    uint8_t v = 0;
    reg_read(reg, &v, 1);
    return v;
}

static uint8_t stop_variable;

static bool vl53_init(void) {
    uint8_t id = 0;
    if (!reg_read(0xC0, &id, 1)) return false;
    printf("Model ID: 0x%02X (expected 0xEE)\n", id);

    reg_write(0x89, reg_read8(0x89) | 0x01); // 2V8 I/O mode
    reg_write(0x88, 0x00);                   // I2C standard mode

    reg_write(0x80, 0x01);
    reg_write(0xFF, 0x01);
    reg_write(0x00, 0x00);
    stop_variable = reg_read8(0x91);
    reg_write(0x00, 0x01);
    reg_write(0xFF, 0x00);
    reg_write(0x80, 0x00);
    return true;
}

// Single-shot measurement. Returns distance in mm, or -1 on error/timeout.
static int vl53_read_mm(void) {
    reg_write(0x80, 0x01);
    reg_write(0xFF, 0x01);
    reg_write(0x00, 0x00);
    reg_write(0x91, stop_variable);
    reg_write(0x00, 0x01);
    reg_write(0xFF, 0x00);
    reg_write(0x80, 0x00);

    reg_write(0x00, 0x01); // start single-shot ranging

    uint64_t t0 = time_us_64();
    while (reg_read8(0x00) & 0x01) {
        if (time_us_64() - t0 > 100000) return -1;
    }
    t0 = time_us_64();
    while ((reg_read8(0x13) & 0x07) == 0) {
        if (time_us_64() - t0 > 100000) return -1;
    }

    uint8_t buf[2];
    if (!reg_read(0x1E, buf, 2)) return -1;
    reg_write(0x0B, 0x01); // clear interrupt
    return (buf[0] << 8) | buf[1];
}

static void diagnose(void) {
    // Level of each line when driven low, then released with internal pull-ups on
    sda_low(); scl_low();
    sleep_us(50);
    int sda_driven = gpio_get(sda_pin);
    int scl_driven = gpio_get(scl_pin);
    sda_high(); scl_high();
    sleep_ms(1);
    int sda_pu = gpio_get(sda_pin);
    int scl_pu = gpio_get(scl_pin);

    // Same with internal pull-ups off: 1 means the module pulls the line up itself
    gpio_disable_pulls(sda_pin);
    gpio_disable_pulls(scl_pin);
    sda_low(); scl_low();
    sleep_us(50);
    sda_high(); scl_high();
    sleep_ms(1);
    int sda_ext = gpio_get(sda_pin);
    int scl_ext = gpio_get(scl_pin);
    gpio_pull_up(sda_pin);
    gpio_pull_up(scl_pin);
    sleep_ms(1);

    printf("SDA=GPIO%d SCL=GPIO%d driven-low: %d/%d, released(int pull-up): %d/%d, released(no pull-up): %d/%d, ACKs:",
           sda_pin, scl_pin, sda_driven, scl_driven, sda_pu, scl_pu, sda_ext, scl_ext);
    for (int a = 1; a < 127; a++) {
        i2c_start();
        bool ack = i2c_write_byte(a << 1);
        i2c_stop();
        if (ack) printf(" 0x%02X", a);
    }
    printf("\n");
}

int main() {
    stdio_init_all();
    i2c_init_pins();

    // Wait for a serial terminal so no output is lost
    while (!stdio_usb_connected()) sleep_ms(100);
    sleep_ms(500);

    printf("VL53L0X live distance test\n");

    while (!vl53_init()) {
        diagnose();
        // Try the swapped pin order on the next attempt
        uint tmp = sda_pin;
        sda_pin = scl_pin;
        scl_pin = tmp;
        i2c_init_pins();
        sleep_ms(500);
    }

    while (true) {
        int mm = vl53_read_mm();
        if (mm < 0) {
            printf("timeout\n");
        } else if (mm >= 8190) {
            printf("%5d mm | out of range\n", mm);
        } else {
            int n = mm / GRAPH_MM_PER_CHAR;
            if (n > GRAPH_MAX_CHARS) n = GRAPH_MAX_CHARS;
            printf("%5d mm |", mm);
            for (int i = 0; i < n; i++) putchar('#');
            putchar('\n');
        }
        sleep_ms(50);
    }
}
